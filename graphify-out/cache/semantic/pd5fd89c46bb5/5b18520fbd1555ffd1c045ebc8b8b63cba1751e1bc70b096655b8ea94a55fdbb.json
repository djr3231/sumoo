{"nodes": [{"id": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_family_plan3_addendum", "label": "Family Members Plan 3 Addendum", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": "Introduction and Scope", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_manage_family_capability", "label": "ManageFamily Capability", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": "Authorization", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit capability removes the Full role's blanket authorization while preserving exhaustive role checks."}, {"id": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_family_management_api", "label": "Family Management API", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": "/api/family", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_strict_registry_update", "label": "Strict Registry Read-Modify-Write", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": "POST and DELETE sequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transient settings read failure must not be interpreted as empty settings and wipe the membership registry."}, {"id": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_idempotent_drive_permission_sync", "label": "Idempotent Drive Permission Sync", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": "Drive sharing mechanics", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listing before create, update, or delete makes repeated POST and DELETE safe and turns re-adding a member into repair for partial sharing failures."}, {"id": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_upload_folder_id_resolution", "label": "Stored Upload Folder ID Resolution", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": "Upload folder on a shared account", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stored owner folder ID avoids nondeterministic name search across identically named personal and shared folders; missing IDs skip image upload rather than write into the wrong Drive."}, {"id": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_active_account_indicator", "label": "Active Shared-Account Indicator", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": "UI / Active-account indicator", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A visible owner-email and role badge closes the data-safety gap caused by personal and shared accounts otherwise looking identical."}, {"id": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_settings_family_management_ui", "label": "Settings Family Management UI", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": "UI / Settings", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_shared_report_path_deferred", "label": "Shared Report Path Deferred", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": "Deviations and Out of scope", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Report folders and templates remain on the member's Drive until a dedicated plan can replace fragile name-based resolution and track stale grants."}, {"id": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_settings_last_write_wins_race", "label": "Settings Last-Write-Wins Race", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": "Known race", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrent settings and family writes can overwrite the shared key-value range; the low-probability race is accepted because Sheets lacks locking."}], "edges": [{"source": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_family_plan3_addendum", "target": "docs_superpowers_specs_2026_07_17_family_members_design_family_account_model_b", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_19_family_members_3_management_sharing_design_family_plan3_addendum", "target": "docs_superpowers_specs_2026_07_17_family_members_design_owner_family_management", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-19-family-members-3-management-sharing-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers